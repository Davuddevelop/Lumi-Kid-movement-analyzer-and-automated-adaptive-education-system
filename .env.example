# ── Lumi backend environment variables ──────────────────────────────
# Copy to .env (local) or set in your host's dashboard (Render/Railway).

# REQUIRED for AI features (chat, smart hints, voice, parent reports).
# Get a key at https://console.anthropic.com → API Keys.
# Without it the app still runs, using rule-based fallback responses.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override where the SQLite database file lives.
# Defaults to lumi.db next to server.py.
# LUMI_DB_PATH=/var/data/lumi.db
